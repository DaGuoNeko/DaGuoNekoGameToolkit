# Rebuildable dependencies and application output
**/node_modules/
**/bin/
**/obj/
/DesktopUI/dist/
/DesktopUI/release/
/DesktopUI/native/*/build/

# Deliberate local development storage
/.miao/work/
/.miao/cache/
/.miao/tools/

# Build-generated runtime files. Source, manifests and reusable runtime files stay tracked.
/DesktopUI/runtime/automation/
/DesktopUI/runtime/update-config.json
/DesktopUI/runtime/native/update-launcher.exe
/DesktopUI/runtime/network/*.exe
/DesktopUI/runtime/network/*.dll
/DesktopUI/runtime/network/*.sys
/DesktopUI/runtime/network/manifest.json
/DesktopUI/native/network-helper/RuntimeHashes.cs

# Machine-only IDE metadata
/.vs/
/.idea/
/.zcode/
/.mcs/
*.user
*.suo
*.userprefs
*.cache

# Local secrets and machine-specific overrides. Shared .env/.vscode/.mcdev files remain visible.
.env.private
.env.*.private
*.secret

# System files are removed by the artifact cleaner; do not hide them with ignore rules.
