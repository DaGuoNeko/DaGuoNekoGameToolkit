{
  "name": "daguoneko-game-toolkit",
  "version": "0.1.14",
  "private": true,
  "productName": "大果喵游戏工具箱",
  "description": "网易我的世界开发测试的独立启动、配置与日志工具",
  "author": "DaGuoNeko",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test --test-concurrency=4 tests/*.test.cjs",
    "test:ui": "npm run build && node tests/ui.cjs",
    "test:debug-ui": "npm run build && node tests/debug-ui.cjs",
    "clean:dev": "node scripts/clean-dev-artifacts.mjs",
    "clean:dev:apply": "node scripts/clean-dev-artifacts.mjs --apply",
    "clean:release": "node scripts/clean-release.mjs",
    "clean:release:apply": "node scripts/clean-release.mjs --apply",
    "package": "npm run clean:release:apply && npm run build && node scripts/package.mjs",
    "release:publish": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "@jsprismarine/leveldb": "0.16.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "jsonc-parser": "3.3.1",
    "prismarine-nbt": "2.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/packager": "20.3.0",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "playwright": "1.63.0"
  }
}
